        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/b684dabf-bc91-46bd-bb7e-477bfdc5ca01",
          "headers": {
            "Connection": "keep-alive",
            "Cache-Control": "no-cache"
          }
        },
        "sockopt": {
